<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>ScreenCapture.NET.DX11</Title>
    <AssemblyName>ScreenCapture.NET.DX11</AssemblyName>
    <AssemblyTitle>ScreenCapture.NET.DX11</AssemblyTitle>
    <PackageId>ScreenCapture.NET.DX11</PackageId>
    <Description>DirectX 11 based Screen-Capturing using the Desktop Duplication API</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Common\*.cs" Link="Shared\Common\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Windows\*.cs" Link="Shared\Windows\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\D3D11\*.cs" Link="Shared\D3D11\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Precompiled with Shared/D3D11/Shaders/Compile.cmd: no shader compiler is needed at build or run time.
         WithCulture="false": MSBuild would take the "ps" of "HdrToneMapping.ps.cso" for a culture (Pashto) and move it to a satellite assembly. -->
    <EmbeddedResource Include="..\Shared\D3D11\Shaders\*.cso" Link="Shared\D3D11\Shaders\%(Filename)%(Extension)" LogicalName="ScreenCapture.NET.Shaders.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenCapture.NET\ScreenCapture.NET.csproj" />
  </ItemGroup>

</Project>
