<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <!-- SharpGen.Runtime (Vortice) warns about its reflection fallback for COM callbacks, which isn't used here.
         IL2104 is the warning about a referenced assembly as a whole; the libraries' own code is still checked by their trim and AOT analyzers (IsAotCompatible). -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ScreenCapture.NET\ScreenCapture.NET.csproj" />
    <ProjectReference Include="..\..\ScreenCapture.NET.WGC\ScreenCapture.NET.WGC.csproj" />
    <ProjectReference Include="..\..\ScreenCapture.NET.DX11\ScreenCapture.NET.DX11.csproj" />
    <ProjectReference Include="..\..\ScreenCapture.NET.DX9\ScreenCapture.NET.DX9.csproj" />
    <ProjectReference Include="..\..\ScreenCapture.NET.X11\ScreenCapture.NET.X11.csproj" />
    <ProjectReference Include="..\..\ScreenCapture.NET.Wayland\ScreenCapture.NET.Wayland.csproj" />
  </ItemGroup>

</Project>
